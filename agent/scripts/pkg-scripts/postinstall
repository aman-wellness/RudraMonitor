#!/bin/bash
# Runs as root during the .pkg install (macOS Installer.app invokes this).
#
# Goal: set up the customer's macOS so the freshly-installed Rudrans Agent
# launches without Gatekeeper warnings AND keeps its Screen Recording / TCC
# grants stable across every future auto-update. The agent binaries are signed
# with our self-signed "Rudrans Software Code Signing" leaf cert in CI. macOS
# only trusts that signature if its root CA ("Rudrans Software Root CA") is in
# the System keychain marked as a trusted code-signing anchor. We ship the
# public root cert inside the .app bundle (see tauri.conf.json bundle.resources)
# and import it here.

set -e

# v0.2.33 renamed the bundle. Probe BOTH paths so this script keeps working
# when a customer upgrades from v0.2.32 (Rudrans Agent.app) — the old
# directory may still be present alongside the new one for a tick.
APP=""
for candidate in \
  "/Applications/Security Assistant.app" \
  "/Applications/Rudrans Agent.app"
do
  if [ -d "$candidate" ]; then
    APP="$candidate"
    break
  fi
done
# Fall back to the new name even if neither exists yet (Installer may not
# have finished writing the bundle when postinstall fires on some macOS
# versions).
APP="${APP:-/Applications/Security Assistant.app}"

# Tauri 2 mirrors source-side resources/ layout, so the .cer can live in either
# of two paths depending on which bundling pass produced it. Probe both.
CER=""
for candidate in \
  "$APP/Contents/Resources/resources/RudransRootCA.cer" \
  "$APP/Contents/Resources/_up_/resources/RudransRootCA.cer" \
  "$APP/Contents/Resources/RudransRootCA.cer"
do
  if [ -f "$candidate" ]; then
    CER="$candidate"
    break
  fi
done

if [ -n "$CER" ]; then
  # trustRoot policy = the cert anchors trust for ALL purposes (codeSigning +
  # SSL etc). For our use we only need codeSigning anchoring, but the more
  # specific `-r codeSign` flag isn't universally honoured across macOS
  # versions; trustRoot is the safe option.
  /usr/bin/security add-trusted-cert -d -r trustRoot \
    -k /Library/Keychains/System.keychain "$CER" 2>/dev/null || true
fi

# Strip the App Translocation quarantine xattr so the first launch doesn't
# show a Gatekeeper warning. This is the .pkg-install equivalent of a user
# right-clicking → Open on a Safari-downloaded .app. Recursively applied.
/usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

# Customers upgrading from a prior ad-hoc-signed build have stale TCC entries
# keyed by the old cdhash. Reset them so the first launch of THIS signed build
# re-prompts ONCE, captures the grant under the new (stable) signing identity,
# and then never re-prompts again.
/usr/bin/tccutil reset ScreenCapture com.rudrans.agent 2>/dev/null || true
/usr/bin/tccutil reset Accessibility com.rudrans.agent 2>/dev/null || true
/usr/bin/tccutil reset SystemPolicyAllFiles com.rudrans.agent 2>/dev/null || true

# ---------------------------------------------------------------------------
# Auto-start on boot and re-login.
#
# We want the agent to come up automatically:
#   • on every system reboot (before the user touches the dock)
#   • on every user login (so it always runs in the active session)
#   • respawn if it gets killed (launchd KeepAlive)
#
# LaunchAgent (not LaunchDaemon): screen capture / accessibility / input
# monitoring TCC grants are bound to the LOGGED-IN user's session. Daemons
# run as root in session 0 and can't capture the user's screen. A plist in
# /Library/LaunchAgents is the per-user, every-user variant launchd loads
# at every login — exactly what's needed.
#
# Without this block customers have to manually open the .app after every
# restart, which the in-process guardian (watchdog.rs) can't help with —
# after reboot everything in memory is gone.
# ---------------------------------------------------------------------------
LABEL="com.rudrans.agent"
LA_PLIST="/Library/LaunchAgents/${LABEL}.plist"
APP_BIN="${APP}/Contents/MacOS/Security Assistant"
if [ ! -x "$APP_BIN" ]; then
  for cand in \
    "${APP}/Contents/MacOS/Rudrans Agent" \
    "${APP}/Contents/MacOS/rudrans-agent"
  do
    if [ -x "$cand" ]; then APP_BIN="$cand"; break; fi
  done
fi

if [ -x "$APP_BIN" ]; then
  cat > "$LA_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${APP_BIN}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>LimitLoadToSessionType</key>
  <array><string>Aqua</string></array>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
EOF
  chown root:wheel "$LA_PLIST"
  chmod 644 "$LA_PLIST"

  # Bootstrap into the current console user's gui session so the agent
  # starts immediately after install (no log-out / log-in cycle needed).
  CONSOLE_USER=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || echo "")
  if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || echo "")
    if [ -n "$CONSOLE_UID" ]; then
      /bin/launchctl bootout "gui/${CONSOLE_UID}/${LABEL}" 2>/dev/null || true
      /bin/launchctl bootstrap "gui/${CONSOLE_UID}" "$LA_PLIST" 2>/dev/null || true
    fi
  fi
fi

exit 0
