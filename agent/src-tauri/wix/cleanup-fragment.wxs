<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom WiX fragment that runs the agent's --uninstall flag during MSI uninstall.
  Wires a deferred custom action so it executes with elevated privileges (needed to
  remove HKCU\...\Run autostart entries on per-user installs and to wipe %APPDATA%).

  Tauri 2 picks this up via tauri.conf.json → bundle.windows.wix.fragmentPaths.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Impersonate="no" — run as SYSTEM. Under Intune the installing account
      IS SYSTEM (IME runs as SYSTEM), so Impersonate="yes" was a no-op
      that only mattered in the rare case of a hand-clicked Add-or-Remove
      Programs uninstall. The Rust `uninstall_self()` now walks C:\Users\*
      and HKEY_USERS\<SID>\* explicitly rather than trusting dirs::* to
      resolve to the interactive user's profile, so SYSTEM context is
      correct in every path (Intune, GPO, ARP).
      -->
    <CustomAction
      Id="RunSelfUninstall"
      FileKey="MainExecutable"
      ExeCommand="--uninstall"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <!-- Run only on uninstall (REMOVE=ALL), and only after the binary is still on disk. -->
      <Custom Action="RunSelfUninstall" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
