<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom WiX fragment that runs the agent's --uninstall flag during MSI uninstall.
  Wires a deferred custom action so it executes with elevated privileges (needed to
  remove HKCU\...\Run autostart entries on per-user installs and to wipe %APPDATA%).

  Tauri 2 picks this up via tauri.conf.json → bundle.windows.wix.fragmentPaths.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Impersonate="yes" so the action runs as the installing user, NOT as SYSTEM.
      Without impersonation, %APPDATA% resolves to the SYSTEM profile
      (C:\Windows\system32\config\systemprofile\AppData) and the user's actual
      TrackForceAgent data dir is left behind.
      -->
    <CustomAction
      Id="RunSelfUninstall"
      FileKey="MainExecutable"
      ExeCommand="--uninstall"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <!-- Run only on uninstall (REMOVE=ALL), and only after the binary is still on disk. -->
      <Custom Action="RunSelfUninstall" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
