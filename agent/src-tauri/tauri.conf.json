{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rudrans Agent",
  "version": "0.2.27",
  "identifier": "com.rudrans.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rudrans Agent",
        "width": 480,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/uninstall.command", "resources/ffmpeg*", "resources/RudransRootCA.cer"],
    "category": "Productivity",
    "shortDescription": "Rudrans employee monitoring agent",
    "longDescription": "Background agent that reports system metrics, active applications, and screenshots to Rudrans.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "hardenedRuntime": true,
      "signingIdentity": "Rudrans Software Code Signing"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.rudrans.com/storage/v1/object/public/releases/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNjg5MEM0MDQ4MTBDMzgKUldRNERJRUV4SkJvU2d1b0JtSHE1bFAxNEZoNElIYVVBRWRNZTJrRFVpbUpBM0ZwejdFNHhaTmUK"
    }
  }
}
