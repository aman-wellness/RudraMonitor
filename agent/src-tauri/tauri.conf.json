{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Security Assistant",
  "version": "0.6.29",
  "identifier": "com.wellnessextract.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Security Assistant",
        "width": 480,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost https://api-ems.wellnessextract.com https://ems.wellnessextract.com wss://api-ems.wellnessextract.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Wellness Extract Pvt. Ltd.",
    "copyright": "© 2026 Wellness Extract Pvt. Ltd. All rights reserved.",
    "homepage": "https://wellnessextract.com",
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/uninstall.command", "resources/ffmpeg*", "resources/WellnessExtractRootCA.cer", "resources/mitm-ca.crt", "resources/rustdesk/**/*", "resources/endpoint-tools/**/*"],
    "category": "Productivity",
    "shortDescription": "Security Assistant — endpoint compliance & activity background service",
    "longDescription": "Background service that reports system health, active applications, and security telemetry to the corporate IT console.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "hardenedRuntime": true,
      "signingIdentity": null,
      "providerShortName": "THJMM6C3XU"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "wix/nsis-mitm-cert.nsh"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "8c7b9c41-3e52-4d2f-9c8e-a1f6e2d7b3a5"
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "scripts/deb-scripts/postinst"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api-ems.wellnessextract.com/storage/v1/object/public/releases/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNjg5MEM0MDQ4MTBDMzgKUldRNERJRUV4SkJvU2d1b0JtSHE1bFAxNEZoNElIYVVBRWRNZTJrRFVpbUpBM0ZwejdFNHhaTmUK",
      "windows": {
        "installMode": "quiet",
        "installerArgs": []
      }
    }
  }
}
