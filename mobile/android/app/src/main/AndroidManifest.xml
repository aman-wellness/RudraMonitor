<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              OAuth deep-link return. After the user signs in through the
              Chrome Custom Tab, Supabase redirects to
              com.wellnessextract.invoice://oauth-callback?code=... and Android
              resolves the intent here. App.tsx's appUrlOpen listener
              picks up the URL and calls handleDeepLink() to exchange
              the code for a Supabase session.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.wellnessextract.invoice" />
            </intent-filter>

            <!--
              Android App Link for the OAuth bridge. autoVerify=true tells
              Android to fetch https://ems.wellnessextract.com/.well-known/assetlinks.json
              and check our APK's signing-cert SHA-256 against the entry
              there. When verified, Android intercepts ANY navigation to
              https://ems.wellnessextract.com/oauth-bridge.html — from
              ANY browser, any app — and routes it directly to this
              activity with the full URL (incl. query string) intact.
              This is the only way to bypass OEM browsers like
              HeyTapBrowser that silently strip OAuth query params from
              the bridge URL before the page can read them.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="ems.wellnessextract.com"
                      android:pathPrefix="/oauth-bridge.html" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- @capacitor/camera: ACCESS the camera + read photos for "Pick from gallery". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- capacitor-native-biometric: required to gate Keychain/KeyStore access. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
</manifest>
